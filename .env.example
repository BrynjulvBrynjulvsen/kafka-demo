# Spring reads environment variables; export these in your shell (a .env file is not loaded automatically).
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPICS=kafka-demo,kafka-demo-lab
KAFKA_DEFAULT_TOPIC=kafka-demo
KAFKA_GROUP_ID=kafka-demo
PORT=8080
SERVER_ADDRESS=127.0.0.1
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Group, replay and lag lessons are enabled by default; create both topics before startup.
# Set false to explicitly disable experiment sampling and commands.
# For a basic demo without the lab topic, also set KAFKA_TOPICS=kafka-demo.
# Workers and workloads still require presenter commands when enabled.
DEMO_EXPERIMENT_ENABLED=true
DEMO_EXPERIMENT_TOPIC=kafka-demo-lab
DEMO_EXPERIMENT_GROUP_PREFIX=kafka-demo-experiment

# Separate read-only Kroxy deck: start with SPRING_PROFILES_ACTIVE=migration.
DEMO_MIGRATION_CONTEXT=kind-kafka-proxy-poc
DEMO_MIGRATION_NAMESPACE=kafka-platform-poc
DEMO_MIGRATION_TELEMETRY_BOOTSTRAP=localhost:32095
DEMO_MIGRATION_TELEMETRY_GROUP=kafka-demo-migration-observer

# Local file holding Kafka SASL/TLS settings for the telemetry listener.
# DEMO_MIGRATION_TELEMETRY_CLIENT_PROPERTIES=/absolute/path/to/.local/telemetry-client.properties
